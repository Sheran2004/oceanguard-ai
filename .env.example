# OceanGuard AI - Configuration Example
# Copy this file to .env and adjust as needed.

# ===== Application =====
APP_NAME=OceanGuard AI
APP_ENV=development          # development | production
DEBUG=true
LOG_LEVEL=INFO

# ===== Backend =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Database =====
# Use sqlite for local dev. For production set DATABASE_URL to a PostgreSQL URL.
DATABASE_URL=sqlite:///./oceanguard.db
# Example PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/oceanguard

# ===== Storage =====
UPLOAD_DIR=./uploads
REPORT_DIR=./reports
MAX_UPLOAD_SIZE_MB=25

# ===== ML Model =====
MODEL_PATH=./ml/models/sonar_debris.pt
MODEL_TYPE=yolov8             # yolov8 | yolov5 | demo
MODEL_NAME=OceanGuard-YOLO-v1
MODEL_VERSION=1.0
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEVICE=cpu                    # cpu | cuda
ANOMALY_THRESHOLD=0.65
ENABLE_DEMO_MODE=true

# ===== Class Configuration =====
CLASSES_CONFIG=./config/classes.yaml

# ===== Auth / Security =====
# Generate a strong secret in production: `openssl rand -hex 32`
SECRET_KEY=change-me-in-production-please-set-env-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== Rate Limiting =====
RATE_LIMIT_PER_MINUTE=120